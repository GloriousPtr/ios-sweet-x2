+void
+AppleCLCD::setBrightnessHw(uint32_t hw)
+{
+	if (hw < 1u) {
+		hw = 1u;
+	}
+	if (hw > 0x7ffu) {
+		hw = 0x7ffu;
+	}
+	fBrightness = hw;
+	if (!fX2) {
+		return;
+	}
+	if (fDsiRegs == NULL) {
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(
+		    SWEET_X2_DSI0_PHYS, 0x400, kIODirectionInOut | kIOMemoryMapperNone, kernel_task);
+		if (md != NULL) {
+			fDsiMap = md->map();
+			md->release();
+			if (fDsiMap != NULL) {
+				fDsiRegs = (volatile uint32_t *)fDsiMap->getVirtualAddress();
+			}
+		}
+		fDsiCmdBuf = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(
+		    kernel_task, kIODirectionOut, 4096, 0xFFFFFFFFULL);
+		if (fDsiCmdBuf != NULL && fDsiCmdBuf->prepare() == kIOReturnSuccess) {
+			fDsiCmdPhys = fDsiCmdBuf->getPhysicalSegment(0, NULL);
+			fDsiCmdVirt = (uint32_t *)fDsiCmdBuf->getBytesNoCopy();
+		}
+	}
+	if (fDsiRegs == NULL || fDsiCmdVirt == NULL || fDsiCmdPhys == 0) {
+		IOLog("SWEET FB: X2 DSI0 map/DMA unavailable\n");
+		return;
+	}
+	/* Samsung AMS641RW16: MIPI DCS 0x51 long write, 1..2047 (0x7ff), big-endian. */
+	fDsiCmdVirt = 0x01000039u | (3u << 8);
+	fDsiCmdVirt = 0x00000051u | (((hw >> 8) & 0x7u) << 8) | ((hw & 0xffu) << 16);
+	flush_dcache((vm_offset_t)fDsiCmdVirt, 64, false);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	uint32_t int_ctrl = fDsiRegs[0x110 / 4];
+	fDsiRegs[0x110 / 4] = int_ctrl | (1u << 24);
+	fDsiRegs[0x048 / 4] = (uint32_t)fDsiCmdPhys;   /* DSI_DMA_CMD_OFFSET */
+	fDsiRegs[0x04c / 4] = 8u;                      /* DSI_DMA_CMD_LENGTH */
+	__asm__ volatile("dsb sy" ::: "memory");
+	fDsiRegs[0x090 / 4] = 1u;                      /* DSI_CMD_MODE_DMA_SW_TRIGGER */
+
+	bool done = false;
+	for (unsigned i = 0; i < 1000; i++) {
+		if (fDsiRegs[0x110 / 4] & (1u << 24)) {
+			fDsiRegs[0x110 / 4] = fDsiRegs[0x110 / 4] | (1u << 24);
+			done = true;
+			break;
+		}
+		IODelay(10);
+	}
+	IOLog("SWEET FB: DCS 0x51 hw=0x%03x done=%d int=0x%x\n", hw, done ? 1 : 0, fDsiRegs[0x110 / 4]);
+}
+
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
 class IOMobileFramebufferUserClient : public IOUserClient {
