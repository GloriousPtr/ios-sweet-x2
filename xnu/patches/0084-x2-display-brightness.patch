+void
+AppleCLCD::setBrightnessFixed(uint32_t level16)
+{
+	if (level16 > 65536u) {
+		level16 = 65536u;
+	}
+	fBrightness = level16;
+	setProperty("brightness", (uint64_t)level16, 32);
+	if (!fX2) {
+		return;
+	}
+	if (fDsiRegs == NULL) {
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(
+		    SWEET_X2_DSI0_PHYS, 0x400, kIODirectionInOut | kIOMemoryMapperNone, kernel_task);
+		if (md != NULL) {
+			fDsiMap = md->map();
+			md->release();
+			if (fDsiMap != NULL) {
+				fDsiRegs = (volatile uint32_t *)fDsiMap->getVirtualAddress();
+			}
+		}
+		fDsiCmdBuf = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(
+		    kernel_task, kIODirectionOut, 4096, 0xFFFFFFFFULL);
+		if (fDsiCmdBuf != NULL && fDsiCmdBuf->prepare() == kIOReturnSuccess) {
+			fDsiCmdPhys = fDsiCmdBuf->getPhysicalSegment(0, NULL);
+			fDsiCmdVirt = (uint32_t *)fDsiCmdBuf->getBytesNoCopy();
+		}
+	}
+	if (fDsiRegs == NULL || fDsiCmdVirt == NULL || fDsiCmdPhys == 0) {
+		IOLog("SWEET FB: X2 DSI0 map/DMA unavailable\n");
+		return;
+	}
+	/* Samsung AMS641RW16: MIPI DCS 0x51 long write, 1..2047 (0x7ff), big-endian. */
+	uint32_t hw = level16 == 0 ? 1u : 1u + ((level16 * 2046u + 32768u) >> 16);
+	if (hw > 0x7ffu) {
+		hw = 0x7ffu;
+	}
+	/* Qualcomm DSI packet header: DT=0x39 (DCS Long Write), VC=0, WC=3, ACK=1 */
+	fDsiCmdVirt[0] = 0x01000039u | (3u << 8);
+	fDsiCmdVirt[1] = 0x00000051u | (((hw >> 8) & 0x7u) << 8) | ((hw & 0xffu) << 16);
+	flush_dcache((vm_offset_t)fDsiCmdVirt, 64, false);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* Clear pending CMD_MODE_DMA_DONE (bit 24) in DSI_INT_CTRL (0x110). */
+	uint32_t int_ctrl = fDsiRegs[0x110 / 4];
+	fDsiRegs[0x110 / 4] = int_ctrl | (1u << 24);
+	fDsiRegs[0x048 / 4] = (uint32_t)fDsiCmdPhys;   /* DSI_DMA_CMD_OFFSET */
+	fDsiRegs[0x04c / 4] = 8u;                      /* DSI_DMA_CMD_LENGTH */
+	__asm__ volatile("dsb sy" ::: "memory");
+	fDsiRegs[0x090 / 4] = 1u;                      /* DSI_CMD_MODE_DMA_SW_TRIGGER */
+
+	for (unsigned i = 0; i < 1000; i++) {
+		if (fDsiRegs[0x110 / 4] & (1u << 24)) {
+			fDsiRegs[0x110 / 4] = fDsiRegs[0x110 / 4] | (1u << 24);
+			break;
+		}
+		IODelay(10);
+	}
+	IOLog("SWEET FB: brightness=%u/65536 -> DCS 0x51 hw=0x%03x\n", level16, hw);
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict != NULL) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+		if (it != NULL) {
+			const OSSymbol *key;
+			while ((key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+				OSObject *val = dict->getObject(key);
+				OSNumber *num = OSDynamicCast(OSNumber, val);
+				IOLog("SWEET FB: setProperty %s = %llu\n", key->getCStringNoCopy(),
+				    num != NULL ? num->unsigned64BitValue() : 0ULL);
+				if (num != NULL && (!strcmp(key->getCStringNoCopy(), "brightness") ||
+				    !strcmp(key->getCStringNoCopy(), "display-brightness"))) {
+					uint64_t v = num->unsigned64BitValue();
+					if (v <= 100) {
+						v = (v * 65536ULL) / 100ULL;
+					}
+					setBrightnessFixed((uint32_t)v);
+				}
+			}
+			it->release();
+		}
+	}
+	return IOService::setProperties(properties);
+}
